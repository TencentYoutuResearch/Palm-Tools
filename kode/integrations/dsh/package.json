{
  "name": "@kode/dsh",
  "version": "0.1.0",
  "description": "Kode Agent profiles, persistent CLI conversations and local/SSH session messaging for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/host.js",
    "./client-api": "./src/backend-client.js",
    "./client": "./lib/agent-client.js",
    "./native-factory": "./src/native-agent-factory.js",
    "./dsh-conversation": "./src/dsh-conversation.js",
    "./package.json": "./package.json",
    "./workspace-backend": "./src/workspace-backend.js",
    "./workspace-registry": "./src/workspace-registry.js"
  },
  "files": [
    "src",
    "lib/agent-client.js",
    "assets",
    "packages",
    "scripts/build-agent-client.js",
    "scripts/build-remote.js",
    "scripts/build-bundle.js",
    "scripts/prepare-desktop-notifications.sh",
    "scripts/install-desktop-shell.js",
    "scripts/build-desktop-screen.js",
    "scripts/audit-history.js",
    "scripts/repair-inbox-history.js",
    "scripts/repair-inbox-history.py",
    "scripts/repair-plugin-records.js",
    "scripts/repair-plugin-records.py",
    "README.md",
    "cordis.patch.yml",
    "cordis.remote.patch.yml",
    "scripts/repair-inbox-history.js",
    "scripts/repair-inbox-history.py",
    "scripts/install-desktop-app.js"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-agent-client.js",
    "prepack": "npm run build:client",
    "build:browser": "node scripts/build-browser.js",
    "build:remote": "node scripts/build-remote.js",
    "build:transport": "node scripts/build-transport.js",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "test:integration": "node scripts/test-integration.js",
    "test:ssh": "python3 scripts/test-ssh.py",
    "build:bundle": "node scripts/build-bundle.js",
    "build:directory-browse": "node scripts/build-directory-browse.js",
    "build:chat": "node scripts/build-chat.js",
    "build:kode-extension": "node scripts/build-kode-extension.js",
    "test:desktop-runtime": "node scripts/test-desktop-runtime.js"
  },
  "bin": {
    "kode-sessions-mcp": "./src/mcp.js"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.96.0",
    "@agentclientprotocol/sdk": "2.0.2",
    "@electron/asar": "4.3.2",
    "@kode/dsh-browser": "file:packages/browser",
    "@kode/dsh-chat": "file:packages/chat",
    "@kode/dsh-directory-browse": "file:packages/directory-browse",
    "@kode/dsh-transport": "file:packages/transport",
    "@modelcontextprotocol/sdk": "1.32.2",
    "js-yaml": "4.3.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-storage": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-web-app": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-bash-local": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.3-alpha.2",
    "esbuild": "^0.25.12",
    "node": "24.22.3"
  }
}
