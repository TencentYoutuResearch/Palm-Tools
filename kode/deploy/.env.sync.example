# Public DNS name whose A/AAAA record points to this server.
KODE_SYNC_DOMAIN=sync.example.com

# Standard public VPS: Caddyfile.sync (Caddy terminates TLS with ACME).
# DevCloud/AIO ingress: Caddyfile.sync.devcloud (AIO terminates public TLS).
KODE_SYNC_CADDYFILE=Caddyfile.sync

# Used by Caddy for ACME expiry notices.
ACME_EMAIL=ops@example.com

# Optional tracing filter.
KODE_SYNC_LOG=info,kode_sync_server=info
