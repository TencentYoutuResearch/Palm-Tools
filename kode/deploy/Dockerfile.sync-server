# syntax=docker/dockerfile:1.7
FROM rust:1.88-bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --locked --release -p kode-sync-server

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10001 --create-home kode \
    && install -d -o kode -g kode /data
COPY --from=builder /src/target/release/kode-sync-server /usr/local/bin/kode-sync-server
USER kode
EXPOSE 8787
ENV KODE_SYNC_BIND=0.0.0.0:8787 \
    KODE_SYNC_DATABASE=/data/kode-sync.db \
    RUST_LOG=info,kode_sync_server=info
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8787/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/kode-sync-server"]
