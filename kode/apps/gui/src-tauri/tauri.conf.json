{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kode",
  "version": "0.2.2-dev",
  "identifier": "app.kode.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1437",
    "beforeDevCommand": "bash ./dev-server.sh",
    "beforeBuildCommand": "bash ./build-sidecar.sh && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "kode",
        "width": 1100,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' customprotocol: asset: http://localhost:1437; connect-src ipc: http://ipc.localhost http://localhost:1437 ws://localhost:1437; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' http://localhost:1437; script-src 'self' http://localhost:1437; font-src 'self' data:; frame-src 'self' data: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/128x128@2x.png",
      "icons/256x256@2x.png",
      "icons/512x512@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/kode-memory", "binaries/kode-memory-mcp", "binaries/specops"],
    "resources": ["resources"],
    "category": "DeveloperTool",
    "shortDescription": "Multi-tab AI session manager",
    "longDescription": "kode — manage multiple codebuddy / claude code sessions in one window.",
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 660, "height": 420 },
        "appPosition": { "x": 180, "y": 205 },
        "applicationFolderPosition": { "x": 480, "y": 205 }
      },
      "signingIdentity": "Developer ID Application: Xiaosong Wang (CRY5MTFJN7)",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1NEE2NTNFNTNCMUJGRDIKUldUU3Y3RlRQbVZLMVpBclFMUWxIa2tlNno3S2VUR1ZVcjdYMVQwKzVDUi9ick1FZ0J4ckNHd1QK",
      "endpoints": [
        "https://github.com/TencentYoutuResearch/Palm-Tools/releases/latest/download/latest.json"
      ]
    }
  }
}
